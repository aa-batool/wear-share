# Copy this file to ".env" and change what you need. The defaults work as they are.

# ---- Your admin login ------------------------------------------------------
# The email and password you use at /admin. Set both and the server makes the
# admin account match them every time it starts (creating it, or changing the old
# one). The password needs at least 10 characters. If you leave these out you get
# the starter demo login (owner@example.com / changeme123), and the server warns
# you about it each time it starts. To change your password later, edit it here and
# restart the server.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Port the server listens on.
PORT=3000

# Set to "production" when deployed: the admin session cookie then gets the
# Secure flag (HTTPS only).
# NODE_ENV=production

# Where the SQLite database file lives (default: data.sqlite in the project folder).
# DATABASE_PATH=

# Shown to customers who choose "Pay online" — where to send the money. Use \n for a
# new line. Without this, online customers are told you'll message them the details.
ONLINE_PAYMENT_INSTRUCTIONS=Bank: YOUR BANK\nAccount title: YOUR NAME\nAccount no / IBAN: PK00 0000 0000 0000 0000 0000\nJazzCash / Easypaisa: 03XX XXXXXXX

# ---- Emails to you (the owner) --------------------------------------------
# Every new order, new intake and status change is emailed to NOTIFY_EMAIL.
# Customers are emailed about their own order too (confirmation, confirmed,
# shipped with tracking number, payment received, delivered...), from the same
# account. Providers are never emailed.
# To send, the site needs an account to send FROM. For Gmail: turn on 2-Step
# Verification for that account, then create an "App password" at
# https://myaccount.google.com/apppasswords and paste it below (not your normal
# password). Leave SMTP_USER / SMTP_PASS empty to switch emails off.
NOTIFY_EMAIL=wearshare300@gmail.com
SMTP_USER=wearshare300@gmail.com
SMTP_PASS=
# Only needed for a provider other than Gmail:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# Your site's public address, used for the "check on your order" line in customer
# emails (e.g. https://wearshare.example). Leave empty until you have one.
# PUBLIC_URL=
# Set to off to stop emailing customers (you still get your own notifications).
# CUSTOMER_EMAILS=off
# Providers (the people who list pieces) are emailed too: when their submission
# arrives, when their piece goes live, when it's booked or bought (never any
# customer details), and when a payout is sent. Set to off to stop those.
# PROVIDER_EMAILS=off

# ---- Late returns ----------------------------------------------------------
# A rental that's still out after its end date is "overdue". By default each late
# day costs the item's daily rent price. Set a flat Rs amount per day instead:
# LATE_FEE_PER_DAY=1000
# The shop's time zone decides when a day ends (default Asia/Karachi).
# SHOP_TIMEZONE=Asia/Karachi

# ---- Hosting (Render etc.; see DEPLOY.md) ----------------------------------
# Set on the host's Environment screen, not in this file:
# NODE_ENV=production       live-site mode: Secure cookies, extra security headers, and NO demo data
# SEED_DEMO=on              load the demo items/orders even in production (client preview only)
# SITE_PASSWORD=...         puts a password prompt in front of the whole site (private preview)
# TRUST_PROXY_HOPS=1        how many proxies sit in front of the site, so each visitor is told apart
# DATABASE_PATH=/var/data/data.sqlite   where the database file lives (a persistent disk)
# NOINDEX=on                ask search engines not to list the site

# ---- Backups ---------------------------------------------------------------
# The site saves a copy of its database about once a day in a "backups" folder
# next to data.sqlite, and keeps the newest 14. You can also download one from the
# admin Dashboard. To change any of that:
# BACKUP_DIR=C:\\wearshare-backups
# BACKUP_KEEP=30
# BACKUP_EVERY=off   (stops the automatic daily copy; the buttons still work)

# ---- Delivery charge -------------------------------------------------------
# A flat delivery fee added to each order (Rs). Leave unset or 0 for none.
# DELIVERY_FEE=300
# Orders whose items total this much or more get free delivery. Leave unset to
# always charge the fee.
# FREE_DELIVERY_OVER=5000
# The fee is shown at checkout, on the tracking page and in emails. It is
# refunded with a cancelled order but never counted in the provider's share.

# ---- Provider payouts ------------------------------------------------------
# The share of an order's total that goes to the person who listed the item
# (default 50). It becomes a pending payout once the customer has paid and the
# rental is back (or the purchase delivered). Late fees and damage charges are
# yours and never shared.
# PROVIDER_SHARE_PERCENT=50

# ---- How customers reach you -----------------------------------------------
# Shown in every page's footer, on the Policies page, on the tracking page and at
# the bottom of customer emails. CONTACT_EMAIL defaults to NOTIFY_EMAIL.
# CONTACT_EMAIL=wearshare300@gmail.com
# CONTACT_WHATSAPP=+92 300 1234567
# CONTACT_PHONE=
